{
  "name": "africa-history-quest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check:translations": "node scripts/check-translations.mjs",
    "check:facts": "node scripts/generate-level-facts.mjs --check",
    "check:levels": "node scripts/generate-level-content.mjs --check",
    "check:legal": "node scripts/check-legal.mjs",
    "check:links": "node scripts/check-search-links.mjs",
    "check:photos": "node scripts/check-photo-sources.mjs",
    "check:references": "node scripts/check-reference-pages.mjs",
    "check:references:record": "node scripts/check-reference-pages.mjs --record",
    "check:site": "node scripts/check-site.mjs",
    "content:pull": "node --env-file-if-exists=.env.local scripts/neon-content.mjs pull",
    "content:push": "node --env-file-if-exists=.env.local scripts/neon-content.mjs push",
    "content:check": "node --env-file-if-exists=.env.local scripts/neon-content.mjs check",
    "stress": "node scripts/stress-load.mjs",
    "optimize:photos": "node scripts/optimize-photos.mjs",
    "photos:stamp": "node scripts/stamp-photos.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "level:facts": "node scripts/generate-level-facts.mjs",
    "level:content": "node scripts/generate-level-content.mjs",
    "weights": "node scripts/report-weights.mjs",
    "weights:record": "node scripts/report-weights.mjs --record",
    "verify": "node scripts/verify.mjs",
    "build": "npm run check:translations --silent && npm run check:facts --silent && npm run check:levels --silent && vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json && tsc -p ./jsconfig.node.json",
    "test": "node --test",
    "preview": "vite preview",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "android:sync": "npm run build --silent && cap sync android"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.16.4",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@eslint/js": "^9.19.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@neondatabase/serverless": "^1.1.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "baseline-browser-mapping": "^2.8.32",
    "esbuild": "^0.25.12",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  }
}
